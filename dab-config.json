{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "Server=FATIMA-LAPTOP\\SQLEXPRESS;Database=salesdb;Integrated Security=True;TrustServerCertificate=True"
  },
  "runtime": {
    "rest": {
      "enabled": false,
      "path": "/api",
      "request-body-strict": true
    },
    "graphql": {
      "enabled": false,
      "path": "/graphql",
      "allow-introspection": true
    }
  },
  "autoentities": {},
  "entities": {
    "Customers": {
      "source": {
        "object": "Sales.Customers",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Customers",
          "plural": "Customers"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ],
      "mcp": false
    }
  }
}